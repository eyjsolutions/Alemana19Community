<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista para Mensajes con Widget Estilizado -->
    <record id="popup_it_form" model="ir.ui.view">
        <field name="name">popup.it.form</field>
        <field name="model">popup.it</field>
        <field name="arch" type="xml">
            <form string="Mensaje" class="popup_it_dialog">
                <sheet style="text-align:center !important">
                    <div style="text-align:center !important">
                        <field name="message" widget="popup_message_widget"/>
                    </div>
                </sheet>
                <footer>
                    <button string="Cerrar" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="popup_it_action">
        <field name="name">Mensaje</field>
        <field name="res_model">popup.it</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="popup_it_form"/>
        <field name="target">new</field>
    </record>

    <!-- Vista para Archivos con Widget Estilizado -->
    <record id="popup_file_it_form" model="ir.ui.view">
        <field name="name">popup.file.it.form</field>
        <field name="model">popup.it</field>
        <field name="arch" type="xml">
            <form string="Archivo Generado" class="popup_it_dialog">
                <sheet style="text-align:center !important">
                    <div style="text-align:center !important">
                        <field name="output_name" invisible="1"/>
                        <field name="output_file" widget="popup_file_widget"/>
                    </div>
                </sheet>
                <footer>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="popup_file_it_action">
        <field name="name">Archivo</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">popup.it</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="popup_file_it_form"/>
        <field name="target">new</field>
    </record>
    
</odoo>
