<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_account_local_alemana_form" model="ir.ui.view">
		<field name="name">account.local.alemana.form</field>
		<field name="model">account.local.alemana</field>
		<field name="arch" type="xml">
			<form string="Cuenta por Tienda">
				<group>
					<group>
						<field name="company_branch_address_id" required="1"/>
						<field name="account_id" required="1"/>
					</group>
				</group>
			</form>
		</field>
	</record>
	<record id="view_account_local_alemana_list" model="ir.ui.view">
		<field name="name">account.local.alemana.list</field>
		<field name="model">account.local.alemana</field>
		<field name="arch" type="xml">
			<list>
				<field name="name" optional="show"/>
				<field name="account_id" optional="show"/>
			</list>
		</field>
	</record>
	<record id="action_account_local_alemana_form" model="ir.actions.act_window">
		<field name="name">Cuenta por Tienda</field>
		<field name="res_model">account.local.alemana</field>
		<field name="view_mode">list,form</field>
		<field name="view_id" ref="view_account_local_alemana_list"/>
		<field name="help" type="html">
		  <p class="o_view_nocontent_smiling_face">
			Crea tu primera tabla de Cuenta por Tienda aqui
		  </p>
		</field>
	</record>
</odoo>