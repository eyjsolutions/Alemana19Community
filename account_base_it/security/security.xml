<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<record model="ir.module.category" id="module_category_accounting_itgrupo">
			<field name="name">CONTABILIDAD ITGRUPO</field>
			<field name="sequence">301</field>
		</record>

		<record id="group_account_tables_user" model="res.groups">
			<field name="name">Show Full Accounting Tables</field>
			<!--field name="category_id" ref="account_base_it.module_category_accounting_itgrupo"/-->
			<field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
		</record>

		<record id="group_query_ruc_dni_root" model="res.groups">
			<field name="name">Parametros Consulta RUC/DNI</field>
			<!--field name="category_id" ref="account_base_it.module_category_accounting_itgrupo"/-->
		</record>

		<record id="group_period_fiscal_year_root" model="res.groups">
			<field name="name">Administrador Años Fiscales/Peridos</field>
			<!--field name="category_id" ref="account_base_it.module_category_accounting_itgrupo"/-->
			<field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
		</record>

		<record id="account_main_parameter_comp_rule" model="ir.rule">
			<field name="name">Parametros Contabilidad multi-company</field>
			<field name="model_id" ref="model_account_main_parameter"/>
			<field name="global" eval="True"/>
			<field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
		</record>

		<record id="it_invoice_serie_comp_rule" model="ir.rule">
			<field name="name">Series de Factura multi-company</field>
			<field name="model_id" ref="model_it_invoice_serie"/>
			<field name="global" eval="True"/>
			<field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
		</record>
	</data>
</odoo>