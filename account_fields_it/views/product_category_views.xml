<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- View product.category form -->
    <record id="view_product_category_form" model="ir.ui.view">
        <field name="name">view.product.category.form</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="account.view_category_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_account_expense_categ_id']" position="after">
                <field name="property_stock_account_input_categ_id"/>
                <field name="property_stock_account_output_categ_id"/>
            </xpath>
            <xpath expr="//field[@name='property_account_income_categ_id']" position="attributes">
               <attribute name="string">Cuenta para Ventas</attribute>
            </xpath>
            <xpath expr="//field[@name='property_account_expense_categ_id']" position="attributes">
               <attribute name="string">Cuenta para Compra</attribute>
            </xpath>
        </field>
    </record>

</odoo>