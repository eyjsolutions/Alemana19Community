<odoo>
	<data>

		<record model="ir.module.category" id="module_category_accounting_it">
			<field name="name">Extras</field>
			<field name="sequence">300</field>
		</record>

		
		<record id="group_popup_it" model="res.groups">
			<field name="name">Popup It</field>
			<field name="category_id" ref="module_category_accounting_it"/>
		</record>
		<record id="base.group_user" model="res.groups">
			<field name="name">Employee</field>
			<field name="user_ids" eval="[(4, ref('base.user_root'))]"/>
			<field name="implied_ids" eval="[(4, ref('group_popup_it'))]"></field>
		</record>
	</data>
</odoo>