<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<record model="ir.ui.view" id="view_account_out_payment_wizard_form">
			<field name="name">account.out.payment.wizard.form</field>
			<field name="model">account.out.payment.wizard</field>
			<field name="arch" type="xml">
				<form string="Anexos">
					<group>
						<group>
							<field name="company_id"/>
							<field name="date_start"/>
							<field name="date_end"/>
						</group>
					</group>
					<footer>
						<button string="Mostrar" name="get_report" type="object" class="oe_highlight"/>
						<button string="Cancel" class="oe_link" special="cancel"/>
					</footer>
				</form>
			</field>
		</record>

		<record id="account_out_payment_wizard_action" model="ir.actions.act_window">
			<field name="name">Informe Cobros</field>
			<field name="type">ir.actions.act_window</field>
			<field name="res_model">account.out.payment.wizard</field>
			<field name="view_mode">form</field>
			<field name="target">new</field>
		</record>

		<menuitem action="account_out_payment_wizard_action" 
				id="menu_account_out_payment_wizard" 
				parent="point_of_sale.menu_point_rep" 
				sequence="101" 
				groups="account_base_it.group_account_tables_user"/>
	</data>
</odoo>